{
  "name": "LancamentoTarefa",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo da tarefa"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada da tarefa"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Manejo",
        "Suplementa\u00e7\u00e3o",
        "Manuten\u00e7\u00e3o",
        "Verifica\u00e7\u00e3o",
        "Sanit\u00e1rio",
        "Outro"
      ],
      "description": "Tipo base da tarefa"
    },
    "tipo_tarefa_id": {
      "type": "string",
      "description": "ID do tipo de tarefa"
    },
    "tipo_tarefa_nome": {
      "type": "string",
      "description": "Nome do tipo de tarefa"
    },
    "grupo_atividade_id": {
      "type": "string",
      "description": "ID do grupo de atividades"
    },
    "grupo_atividade_nome": {
      "type": "string",
      "description": "Nome do grupo de atividades"
    },
    "solicitante": {
      "type": "string",
      "description": "Nome do solicitante da tarefa"
    },
    "data_pedido": {
      "type": "string",
      "format": "date",
      "description": "Data do pedido da tarefa"
    },
    "setor_nome": {
      "type": "string",
      "description": "Fazenda ou setor relacionado \u00e0 tarefa"
    },
    "prioridade": {
      "type": "string",
      "enum": [
        "Baixa",
        "M\u00e9dia",
        "Alta"
      ],
      "default": "M\u00e9dia",
      "description": "Prioridade da tarefa"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pendente",
        "Em Andamento",
        "Conclu\u00edda",
        "Cancelada"
      ],
      "default": "Pendente",
      "description": "Status da tarefa"
    },
    "data_prevista": {
      "type": "string",
      "format": "date",
      "description": "Data prevista para execu\u00e7\u00e3o"
    },
    "data_inicio": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de in\u00edcio"
    },
    "data_conclusao": {
      "type": "string",
      "format": "date",
      "description": "Data real de conclus\u00e3o"
    },
    "area_id": {
      "type": "string",
      "description": "ID da \u00e1rea vinculada (primeira \u00e1rea, para compatibilidade)"
    },
    "area_nome": {
      "type": "string",
      "description": "Nome da \u00e1rea (para compatibilidade)"
    },
    "area_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs das \u00e1reas vinculadas (sele\u00e7\u00e3o m\u00faltipla)"
    },
    "area_nomes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Nomes das \u00e1reas vinculadas (sele\u00e7\u00e3o m\u00faltipla)"
    },
    "lote_id": {
      "type": "string",
      "description": "ID do lote vinculado"
    },
    "lote_nome": {
      "type": "string",
      "description": "Nome do lote"
    },
    "ponto_suplementacao_id": {
      "type": "string",
      "description": "ID do ponto de suplementa\u00e7\u00e3o vinculado"
    },
    "coordenadas": {
      "type": "object",
      "description": "Coordenadas da tarefa (lat, lng)"
    },
    "responsavel_id": {
      "type": "string",
      "description": "ID do respons\u00e1vel pela execu\u00e7\u00e3o"
    },
    "responsavel": {
      "type": "string",
      "description": "Respons\u00e1vel pela execu\u00e7\u00e3o"
    },
    "responsavel_geral": {
      "type": "string",
      "description": "Respons\u00e1vel geral da tarefa"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es da tarefa"
    },
    "observacoes_conclusao": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es finais"
    },
    "fotos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "URLs das fotos/imagens da tarefa"
    },
    "anexos_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "URLs de anexos/fotos (legado)"
    }
  },
  "required": [
    "empresa_id",
    "titulo",
    "tipo",
    "tipo_tarefa_id"
  ]
}